{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapboard.local/schema/assembly-host.schema.json",
  "title": "SnapBoard Assembly Host",
  "type": "object",
  "required": [
    "id", "schemaVersion", "label", "kind", "summary", "status", "family",
    "compatibilityKey", "systemKey", "nominalGeometryMm", "occupancy", "recipe",
    "validation", "interchangeability", "sources"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "schemaVersion": { "const": 1 },
    "label": { "type": "string", "minLength": 1, "maxLength": 160 },
    "kind": { "enum": ["hole-pattern", "rail-clip", "t-slot", "surface-pad"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "status": { "enum": ["available", "experimental", "planned"] },
    "family": { "type": "string", "minLength": 1 },
    "compatibilityKey": { "type": "string", "minLength": 1 },
    "systemKey": { "type": "string", "minLength": 1 },
    "standard": { "type": ["string", "null"] },
    "nominalGeometryMm": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
    "occupancy": {
      "type": "object",
      "required": ["kind", "clearanceMm", "collisionPolicy"],
      "properties": {
        "kind": { "enum": ["discrete-targets", "axis-interval", "surface-footprint"] },
        "clearanceMm": { "type": "number", "minimum": 0 },
        "collisionPolicy": { "enum": ["reject-overlap", "warn-overlap"] }
      }
    },
    "recipe": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "validation": { "type": "object" },
    "interchangeability": { "type": "object" },
    "sources": { "type": "array", "items": { "type": "object" } }
  }
}

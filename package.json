{
  "name": "snapboard-workspace",
  "version": "1.3.2-diy.1",
  "private": true,
  "workspaces": [
    "snapboard-v2",
    "apps/wiki",
    "desktop"
  ],
  "scripts": {
    "dev": "npm --workspace snapboard-v2 run dev",
    "build": "npm --workspace snapboard-v2 run build",
    "lint": "npm --workspace snapboard-v2 run lint",
    "wiki:dev": "npm run dev",
    "wiki:build": "npm --workspace apps-wiki run build",
    "wiki:serve": "npm --workspace apps-wiki run serve",
    "site:build": "node scripts/build-public-site.mjs",
    "site:build:public": "node scripts/build-public-site.mjs --public-only",
    "build:all": "npm run build && npm run wiki:build",
    "build:diy": "npm --workspace snapboard-v2 run build:diy",
    "verify:diy": "node scripts/verify-diy-release.mjs"
  },
  "license": "GPL-3.0-only"
}
